{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://climateandtech.com/report-analyst/schemas/questionset-document/v1",
  "title": "Question set document",
  "type": "object",
  "required": ["name", "questions"],
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "shortcut": { "type": "string" },
    "documents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "analysis_guidelines": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "guidelines": { "type": "string" },
          "answer_type": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["classification", "quantity", "narrative"]
              },
              "spec": { "type": "string" }
            }
          }
        }
      }
    }
  }
}